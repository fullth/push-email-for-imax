CGV_ENDPOINT=https://example.invalid/cgv/schedule
CGV_REQUEST_JSON={}
CGV_HEADERS_JSON={"Content-Type":"application/json","User-Agent":"cgv-open-push-email/0.1"}
CGV_COOKIES_JSON={}
CGV_POLL_INTERVAL_SECONDS=60
CGV_TIMEOUT_SECONDS=20
CGV_STATE_PATH=/data/state.sqlite3

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_USE_TLS=true
MAIL_FROM=your-account@example.com
MAIL_TO=your-account@example.com
MAIL_SUBJECT_PREFIX=[CGV 예매 오픈]
NTFY_TOPIC_URL=https://ntfy.sh/replace-with-private-topic
